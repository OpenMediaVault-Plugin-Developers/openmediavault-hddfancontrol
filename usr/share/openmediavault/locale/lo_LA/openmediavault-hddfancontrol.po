msgid "Config"
msgstr "ການຕັ້ງຄ່າ"

msgid "Drives"
msgstr "ໄດຣຟ໌"

msgid "Enable HDD Fan Control"
msgstr "ເປີດນຳໃຊ້ການຄວບຄຸມພັດລົມ HDD"

msgid "Fans"
msgstr "ພັດລົມ"

msgid "HDD Fan"
msgstr "ພັດລົມ HDD"

msgid "HDD Fan Control"
msgstr "ການຄວບຄຸມພັດລົມ HDD"

msgid "ID"
msgstr "ໄອດີ"

msgid "Is Cooled"
msgstr "ໄດ້ຮັບການລະບາຍຄວາມຮ້ອນ"

msgid "Maximum Speed Temperature (C)"
msgstr "ອຸນຫະພູມຄວາມໄວສູງສຸດ (C)"

msgid "Minimum Speed (%)"
msgstr "ຄວາມໄວຕໍ່າສຸດ (%)"

msgid "Minimum Speed Temperature (C)"
msgstr "ອຸນຫະພູມຄວາມໄວຕໍ່າສຸດ (C)"

